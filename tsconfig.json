{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",

		// Sources are JavaScript. Each module's sibling .d.ts is the type
		// contract, and tsc only checks those declarations.
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src/**/*.d.ts", "test/**/*.d.ts"]
}
