{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",

		// Node runs the .ts sources directly by stripping types, so nothing here
		// emits. `tsc` is only ever a checker in this spike, which is also why
		// the source imports carry explicit `.ts` extensions.
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"allowJs": true,

		"strict": true,
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src", "test", "scripts"]
}
