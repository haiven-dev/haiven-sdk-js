{
	"name": "@haiven/sdk-ts",
	"version": "0.1.0-preview.1",
	"private": true,
	"type": "module",
	"description": "Haiven client SDK for JavaScript, with TypeScript declarations.",
	"engines": {
		"node": ">=22.18"
	},
	"exports": {
		".": {
			"types": "./src/client.d.ts",
			"default": "./src/client.js"
		},
		"./contracts": {
			"types": "./src/contracts.d.ts",
			"default": "./src/contracts.js"
		},
		"./vocabulary": {
			"types": "./src/vocabulary.d.ts",
			"default": "./src/vocabulary.js"
		},
		"./testing": {
			"types": "./src/ws/fake-server.d.ts",
			"default": "./src/ws/fake-server.js"
		}
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"test": "node --test \"test/**/*.test.js\"",
		"typecheck": "tsc --noEmit",
		"extract": "node scripts/extract-swagger.mjs"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "5.9.3"
	}
}
