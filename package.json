{
	"name": "@haiven/sdk-ts",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Haiven client SDK for TypeScript and JavaScript.",
	"engines": {
		"node": ">=22.18"
	},
	"exports": {
		".": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./contracts": {
			"types": "./dist/contracts.d.ts",
			"default": "./dist/contracts.js"
		},
		"./vocabulary": {
			"types": "./dist/vocabulary.d.ts",
			"default": "./dist/vocabulary.js"
		},
		"./testing": {
			"types": "./dist/ws/fake-server.d.ts",
			"default": "./dist/ws/fake-server.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "node --test \"test/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"extract": "node scripts/extract-swagger.mjs",
		"prepare": "npm run build"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "5.9.3"
	}
}
